<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="4dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvIniciales"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circulo"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto2"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvActual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="sans-serif-light"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:text="00:00:00"
        android:textColor="@color/texto"
        android:textSize="56sp" />

    <TextView
        android:id="@+id/tvTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:text="/ 00:00:00"
        android:textColor="@color/texto2"
        android:textSize="15sp" />

    <pe.javier.grabadora.LineaTiempo
        android:id="@+id/linea"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/tvMarcasTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/texto2"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/lvMarcas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:listSelector="@drawable/bg_chip" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnAtras"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_btn_redondo"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/menos_10"
            android:textColor="@color/texto"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/bg_btn_grabar"
            android:contentDescription="@string/reproducir"
            android:elevation="6dp"
            android:padding="26dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play" />

        <TextView
            android:id="@+id/btnAdelante"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_btn_redondo"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/mas_10"
            android:textColor="@color/texto"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCompartir"
            style="@style/Chip"
            android:drawableStart="@drawable/ic_share"
            android:text="@string/compartir" />

        <TextView
            android:id="@+id/btnMarcar"
            style="@style/Chip"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:drawableStart="@drawable/ic_flag"
            android:drawableTint="@color/marca"
            android:text="@string/marcar" />

        <TextView
            android:id="@+id/btnVel"
            style="@style/Chip"
            android:minWidth="64dp"
            android:text="1x" />
    </LinearLayout>
</LinearLayout>
